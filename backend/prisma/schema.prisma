generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  faculty
  college_admin
  it_user
  it_admin
  amylearn_manager
  amylearn_admin
}

enum TenantType {
  college
  individual
}

enum TenantStatus {
  active
  suspended
}

enum MembershipStatus {
  active
  suspended
}

model User {
  id                  String    @id @default(uuid())
  amylearnId          String?   @unique
  email               String    @unique
  name                String
  password            String
  emailVerified       Boolean   @default(true)
  passwordChangedAt   DateTime?
  deletionScheduledAt DateTime?
  createdAt           DateTime  @default(now())
  role                UserRole  @default(student)
  department          String    @default("General")
  college             String?

  memberships          Membership[]
  studentProfiles      StudentProfile[]
  facultyProfiles      FacultyProfile[]
  adminProfiles        AdminProfile[]
  itUserProfiles       ITUserProfile[]
  itAdminProfiles      ITAdminProfile[]
  notices              Notice[]           @relation("PosterNotices")
  leaveApplications    LeaveApplication[] @relation("ApplicantLeaves")
  digitalResources     DigitalResource[]
  physicalBooksIssued  BookCopy[]         @relation("BookIssuedTo")
  attendanceRecords    AttendanceRecord[] @relation("StudentAttendance")
  markedAttendances    Attendance[]       @relation("FacultyAttendance")
  routines             RoutinePeriod[]    @relation("FacultyRoutines")
  weeklyReports        WeeklyReport[]

  @@map("users")
}

model Tenant {
  id                  String       @id @default(uuid())
  name                String       @unique
  type                TenantType   @default(college)
  subdomain           String?
  logoUrl             String?
  collegeCode         String?      @unique
  location            String       @default("India")
  category            String       @default("University")
  featured            Boolean      @default(false)
  status              TenantStatus @default(active)
  createdAt           DateTime     @default(now())
  deletionScheduledAt DateTime?

  memberships       Membership[]
  departments       Department[]
  subjects          Subject[]
  batches           Batch[]
  classrooms        Classroom[]
  notices           Notice[]
  leaveApplications LeaveApplication[]
  digitalResources  DigitalResource[]
  physicalBooks     PhysicalBook[]
  credentials       LibraryCredential[]
  routines          Routine[]
  attendances       Attendance[]
  weeklyReports     WeeklyReport[]
  examSessions      ExamSession[]
  examResults       ExamResult[]

  @@map("tenants")
}

model Membership {
  id       String           @id @default(uuid())
  userId   String
  tenantId String
  role     UserRole
  status   MembershipStatus @default(active)
  joinedAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId, tenantId])
  @@index([tenantId, role])
  @@map("memberships")
}

model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  tenantId     String
  rollNumber   String?
  batchId      String?
  departmentId String?
  createdAt    DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("student_profiles")
}

model FacultyProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  tenantId     String
  employeeId   String?
  departmentId String?
  designation  String?
  createdAt    DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("faculty_profiles")
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  tenantId  String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("admin_profiles")
}

model ITUserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("it_user_profiles")
}

model ITAdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("it_admin_profiles")
}

model Department {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  code             String?
  headOfDepartment String?
  createdAt        DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjects Subject[]
  streams  Stream[]
  @@map("departments")
}

model Stream {
  id             String  @id @default(uuid())
  departmentId   String
  name           String
  code           String?
  isConfigured   Boolean @default(false)
  isLocked       Boolean @default(false)
  curriculumType String  @default("Semester")
  totalTerms     Int     @default(8)
  oddStartMonth  String  @default("July")
  oddEndMonth    String  @default("December")
  evenStartMonth String  @default("January")
  evenEndMonth   String  @default("June")
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@map("streams")
}

model Subject {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  code         String
  type         String   @default("Theory")
  credits      Int      @default(3)
  semester     Int
  year         Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  routines   RoutinePeriod[]
  attendances Attendance[]
  @@unique([tenantId, code])
  @@map("subjects")
}

model Batch {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  startYear    Int
  endYear      Int
  departmentId String?
  createdAt    DateTime @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routines    Routine[]
  attendances Attendance[]
  weeklyReports WeeklyReport[]
  @@map("batches")
}

model Classroom {
  id         String  @id @default(uuid())
  tenantId   String
  roomNumber String
  building   String?
  capacity   Int?
  createdAt  DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("classrooms")
}

model ClassModule {
  id          String  @id @default(uuid())
  subjectId   String
  title       String
  description String?
  orderNumber Int     @default(1)
  createdAt   DateTime @default(now())
  contents ClassContent[]
  @@map("class_modules")
}

model ClassContent {
  id        String  @id @default(uuid())
  moduleId  String
  title     String
  type      String  @default("Video")
  url       String
  duration  String?
  createdAt DateTime @default(now())
  module ClassModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@map("class_contents")
}

model Notice {
  id         String   @id @default(uuid())
  tenantId   String
  type       String   // 'staff' | 'departmental'
  department String?
  category   String   @default("Announcement")
  posterId   String
  posterName String?
  posterRole String?
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poster   User           @relation("PosterNotices", fields: [posterId], references: [id], onDelete: Cascade)
  comments NoticeComment[]
  reactions NoticeReaction[]
  @@index([tenantId])
  @@map("notices")
}

model NoticeComment {
  id        String   @id @default(uuid())
  noticeId  String
  userId    String
  userName  String?
  text      String
  parentId  String?
  createdAt DateTime @default(now())
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  @@index([noticeId])
  @@map("notice_comments")
}

model NoticeReaction {
  id       String @id @default(uuid())
  noticeId String
  userId   String
  userName String?
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  @@map("notice_reactions")
}

model LeaveApplication {
  id          String    @id @default(uuid())
  tenantId    String
  applicantId String
  type        String    // 'Casual' | 'Medical' | ...
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("Pending") // Pending | Approved | Rejected
  approvedBy  String?
  actionedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant User   @relation("ApplicantLeaves", fields: [applicantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([applicantId])
  @@map("leave_applications")
}

model LibraryCredential {
  id           String   @id @default(uuid())
  tenantId     String
  providerName String
  loginId      String   // stored AES-256-GCM encrypted
  password     String   // stored AES-256-GCM encrypted
  link         String?
  note         String?
  updatedAt    DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("library_credentials")
}

model DigitalResource {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  author      String
  department  String
  course      String?
  type        String    @default("Notes")
  url         String
  description String?
  semester    Int       @default(1)
  status      String    @default("Approved") // Pending | Approved | Rejected
  addedById   String?
  deleteAfter DateTime?
  createdAt   DateTime  @default(now())
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addedBy  User?        @relation(fields: [addedById], references: [id], onDelete: SetNull)
  @@map("digital_resources")
}

model PhysicalBook {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  author      String
  isbn        String?
  category    String?
  baseId      String
  deleteAfter DateTime?
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies BookCopy[]
  @@map("physical_books")
}

model BookCopy {
  id         String    @id @default(uuid())
  bookId     String
  copyId     String    @unique
  status     String    @default("Available") // Available | Issued | Lost
  issuedToId String?
  issuedDate DateTime?
  dueDate    DateTime?
  book     PhysicalBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  issuedTo User?        @relation("BookIssuedTo", fields: [issuedToId], references: [id], onDelete: SetNull)
  @@index([issuedToId])
  @@map("book_copies")
}

model Routine {
  id        String   @id @default(uuid())
  tenantId  String
  batchId   String
  dayOfWeek String
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch   Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  periods RoutinePeriod[]
  @@map("routines")
}

model RoutinePeriod {
  id           String  @id @default(uuid())
  routineId    String
  periodNumber Int
  subjectId    String?
  facultyId    String?
  startTime    String?
  endTime      String?
  routine Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  faculty  User?   @relation("FacultyRoutines", fields: [facultyId], references: [id], onDelete: SetNull)
  @@map("routine_periods")
}

model Attendance {
  id           String   @id @default(uuid())
  tenantId     String
  date         DateTime
  batchId      String
  periodId     String?
  subjectId    String
  facultyId    String
  isFinalized  Boolean  @default(true)
  markedAt     DateTime @default(now())
  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch   Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty User               @relation("FacultyAttendance", fields: [facultyId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]
  @@index([tenantId, date])
  @@index([batchId])
  @@map("attendances")
}

model AttendanceRecord {
  id           String @id @default(uuid())
  attendanceId String
  studentId    String
  status       String @default("Present") // Present | Absent | Late
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId])
  @@index([attendanceId])
  @@map("attendance_records")
}

model WeeklyReport {
  id            String   @id @default(uuid())
  tenantId      String?
  batchId       String?
  weekStartDate DateTime
  weekEndDate   DateTime
  generatedById String?
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch       Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  @@map("weekly_reports")
}

model ExamSession {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("Upcoming") // Upcoming | Active | Completed
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("exam_sessions")
}

model ExamResult {
  id        String   @id @default(uuid())
  tenantId  String
  studentId String
  subjectId String
  marks     Float
  grade     String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("exam_results")
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  @@map("email_verifications")
}

model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
  @@map("system_configs")
}

model Counter {
  id  String @id @default(uuid())
  key String @unique
  seq Int    @default(0)
  @@map("counters")
}
